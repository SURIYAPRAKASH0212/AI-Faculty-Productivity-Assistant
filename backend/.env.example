# Google Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection: gemini-2.5-flash is default for speed, can be swapped to gemini-2.5-pro
GEMINI_MODEL_NAME=gemini-2.5-flash
PORT=8000
HOST=0.0.0.0

# Allowed CORS Origins (comma separated list of URLs). Leave empty or comment out to dynamically allow all origins.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

